rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. User Profiles
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Collaborative Databases
    match /databases/{databaseId} {
      // Allow getting a specific database to check if it exists (for joining)
      allow get: if request.auth != null;
      
      // Allow querying databases only if the user is a collaborator
      allow list: if request.auth != null && request.auth.uid in resource.data.collaborator_ids;
      
      // Allow creation if the user is the owner and adds themselves as a collaborator
      allow create: if request.auth != null 
                    && request.resource.data.owner_id == request.auth.uid
                    && request.auth.uid in request.resource.data.collaborator_ids;
                    
      // Allow update if the user is already a collaborator, or if they are joining securely
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.collaborator_ids ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['collaborator_ids']) &&
          request.resource.data.collaborator_ids.hasAll(resource.data.collaborator_ids) &&
          request.auth.uid in request.resource.data.collaborator_ids
        )
      );

      // 3. Subcollections (Meals, Plans, Settings)
      match /{document=**} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/databases/$(databaseId)).data.collaborator_ids;
      }
    }
  }
}
